# ==============================================================================
# Environment Configuration for Docker & Traefik Deployment
# ==============================================================================

APP_NAME="Inventaris & Aset Sekolah"
APP_ENV=production
APP_KEY=base64:NL7/KlXCP6efHyBYB7Bd2PFOC1Ny9YcO/IQd1lfWY5A=
APP_DEBUG=false
APP_URL=https://inventaris.example.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Docker Hub Image
DOCKER_IMAGE=rizzzdev/smi-bn:latest

# ------------------------------------------------------------------------------
# Traefik & Docker Networking Configuration
# ------------------------------------------------------------------------------
# Host domain yang diarahkan Traefik ke container app
ORIGIN=inventaris.example.sch.id
# Router name unik untuk Traefik
TRAEFIK_NAME=inventaris
# Port internal Nginx di container (default: 80)
PORT=80
# Port host jika ingin diakses langsung tanpa Traefik (misal: http://localhost:8000)
APP_PORT=8000

# ------------------------------------------------------------------------------
# Database: MariaDB / MySQL (Nama Container / Host di Docker Network: backend)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=inventaris_sekolah
DB_USERNAME=inventaris_user
DB_PASSWORD=secret123

# ------------------------------------------------------------------------------
# Session, Cache, & Queue (Nama Container / Host di Docker Network: backend)
# ------------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Storage, Mail, & Frontend
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="inventaris@example.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
