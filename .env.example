APP_NAME="Inventaris & Aset Sekolah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: MySQL 8 / MariaDB 10.11+
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventaris_sekolah
DB_USERNAME=root
DB_PASSWORD=
DB_ROOT_PASSWORD=root123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Redis (opsional; pasang ekstensi phpredis / predis terlebih dahulu)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="inventaris@example.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Jakarta

# Lokasi Chrome/Edge untuk mencetak PDF laporan. Kosongkan agar dideteksi
# otomatis; dompdf dipakai sebagai cadangan bila tidak ditemukan.
CHROME_PATH=

# ==============================================================================
# Docker & Traefik Reverse Proxy Configuration
# ==============================================================================
ORIGIN=inventaris.example.sch.id
TRAEFIK_NAME=inventaris
PORT=80
APP_PORT=8000

# ==============================================================================
# Super Administrator Initial Seed Configuration (Production / Initial Setup)
# ==============================================================================
SUPER_ADMIN_NAME="Super Admin Pengguna"
SUPER_ADMIN_DEGREE="S.Kom"
SUPER_ADMIN_EMAIL="superadmin@gmail.com"
SUPER_ADMIN_PASSWORD="GantiPasswordSuperAdminKuat123!"
SUPER_ADMIN_BIRTH_DATE="1980-01-01"
SUPER_ADMIN_ROLE=SUPER_ADMIN_PENGGUNA

# Kontrol Seeder Demo (false = hanya master data & super admin yang di-seed)
SEED_DEMO_DATA=false


# ==============================================================================
# Bootstrap awal Super Admin Pengguna (jalankan: php artisan user:bootstrap-admin)
# Email WAJIB diisi administrator. Password awal tidak disimpan di sini:
# dibuat acak dan hanya dicetak sekali oleh command.
# ==============================================================================
BOOTSTRAP_USER_ADMIN_NAME="Super Admin Pengguna"
# Email akun harus diisi administrator (jangan pakai contoh). Bila kosong,
# command menolak berjalan agar tidak membuat akun dengan alamat karangan.
BOOTSTRAP_USER_ADMIN_EMAIL="superadmin@gmail.com"
# Password awal (min. 12 karakter). Diisi bila administrator ingin dapat
# membaca kembali kredensial awal; kosongkan agar dibuat acak oleh command.
# Hapus/kosongkan lagi setelah login pertama karena akun wajib ganti password.
BOOTSTRAP_USER_ADMIN_PASSWORD=
